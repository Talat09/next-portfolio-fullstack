# Copy to .env and fill in. Never commit .env.

# --- Server secrets (required; set in Vercel > Settings > Environment Variables) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
# 32+ random chars, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<random-48-byte-base64url>

# --- Public site config (non-secret, inlined into the browser bundle) ---
NEXT_PUBLIC_SITE_URL=https://your-site.example.com
NEXT_PUBLIC_OG_IMAGE_URL=https://your-site.example.com/og-image.png
NEXT_PUBLIC_CV_URL=/your-cv.pdf
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CONTACT_LOCATION=City, Country
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/your-profile
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/your-username
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/your-profile/
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/your-profile/

# Remote image hosts allowed by next/image and the CSP (comma-separated)
IMAGE_REMOTE_HOSTS=i.ibb.co